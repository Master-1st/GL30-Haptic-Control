* text=auto

*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ioc text eol=lf
*.uvprojx text eol=lf
*.ps1 text eol=crlf

# STM32CubeMX emits these generated files with CRLF. Matching the generator
# prevents a clean regeneration from appearing as an all-file line-ending diff.
firmware-stm32/cubemx/GL30_AMOLED_V7/Core/** text eol=crlf
firmware-stm32/cubemx/GL30_AMOLED_V7/Drivers/** text eol=crlf
firmware-stm32/cubemx/GL30_AMOLED_V7/MDK-ARM/** text eol=crlf
firmware-stm32/cubemx/GL30_AMOLED_V7/*.ioc text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.xlsx binary
*.step binary
*.stp binary
*.pdf binary

# Preserve the native AD snapshot and its byte-based integrity manifest.
hardware/pcb/stm32-foc-a-altium-r6/** -text
