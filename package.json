{
  "name": "gl30-haptic-control",
  "private": true,
  "version": "0.2.0",
  "description": "Open-source real-time haptic control platform with an STM32 motor core and software-defined haptic profiles",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vectors": "tsx scripts/generate-golden-vectors.ts",
    "check": "pnpm -r run typecheck",
    "test": "tsx --test tests/**/*.test.ts",
    "e2e": "tsx scripts/e2e-no-hardware.ts",
    "verify": "pnpm vectors && pnpm check && pnpm test && pnpm e2e"
  },
  "devDependencies": {
    "@gl30/core": "workspace:*",
    "@gl30/profile": "workspace:*",
    "@gl30/protocol": "workspace:*",
    "typescript": "^5.6.3",
    "tsx": "^4.23.15",
    "ajv": "^8.17.1",
    "@types/node": "^24.3.0"
  }
}
