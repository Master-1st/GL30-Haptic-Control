[
  {
    "profileVersion": 1,
    "id": "game.performance",
    "name": "游戏性能仪表",
    "description": "显示FPS、1% Low、帧时间和GPU温度；旋转切换页面。",
    "applicationMatch": {
      "processNames": [
        "game.exe"
      ],
      "priority": 80
    },
    "haptic": {
      "mode": "detent",
      "detent": {
        "widthDeg": 15,
        "strengthmNm": 12,
        "waveform": "sine",
        "snapRatio": 0.72,
        "asymmetry": 0
      },
      "damping": 0.00035,
      "friction": 0.001,
      "inertia": 3e-05,
      "endstops": {
        "enabled": false,
        "strengthmNm": 0,
        "softZoneDeg": 5
      },
      "activePosition": {
        "enabled": false,
        "maxTorquemNm": 0,
        "maxRpm": 0,
        "yieldOnTouch": true
      }
    },
    "display": {
      "theme": "pure_black",
      "accent": "#42A5F5",
      "brightness": 55,
      "metricUpdateHz": 20,
      "pages": [
        {
          "type": "game_fps",
          "title": "GAME",
          "metrics": [
            "fps",
            "one_percent_low",
            "frame_time_ms",
            "gpu_temp_c"
          ],
          "windowSeconds": 2
        },
        {
          "type": "frame_time",
          "title": "FRAME TIME",
          "metrics": [
            "frame_time_min",
            "frame_time_max",
            "frame_time_p99"
          ],
          "windowSeconds": 4
        },
        {
          "type": "ui_performance",
          "title": "DEVICE",
          "metrics": [
            "ui_fps",
            "render_ms",
            "flush_ms",
            "uart_loss"
          ],
          "windowSeconds": 2
        }
      ],
      "burnInProtection": {
        "pixelOrbit": true,
        "orbitPixels": 2,
        "dimAfterSec": 45,
        "screenOffAfterSec": 300
      }
    },
    "inputs": {
      "rotate": "next_page",
      "touch": "toggle_primary_metric",
      "doubleTap": "pin_process",
      "longPress": "engineering_overlay",
      "touchAndRotate": "change_graph_window"
    },
    "actions": [
      {
        "event": "rotate",
        "transport": "local",
        "command": "page_delta",
        "scale": 1,
        "deadband": 0
      }
    ],
    "dataSources": {
      "presentMon": true,
      "libreHardwareMonitor": true,
      "rtssFallback": true,
      "deviceTelemetry": true,
      "preferredTransport": "auto"
    },
    "safetyUserCaps": {
      "continuousTorquemNm": 24,
      "transientTorquemNm": 45,
      "selfDriveTorquemNm": 10,
      "selfDriveRpm": 30
    }
  },
  {
    "profileVersion": 1,
    "id": "video.timeline",
    "name": "视频时间轴",
    "description": "低速精细Jog，高速进入惯性滚动，剪辑点形成动态磁吸。",
    "applicationMatch": {
      "processNames": [
        "Adobe Premiere Pro.exe",
        "Resolve.exe"
      ],
      "priority": 90
    },
    "haptic": {
      "mode": "inertial_scroll",
      "detent": {
        "widthDeg": 2.5,
        "strengthmNm": 8,
        "waveform": "smoothstep",
        "snapRatio": 0.65,
        "asymmetry": 0,
        "magneticPositions": [
          0,
          120,
          240,
          360
        ]
      },
      "damping": 0.00022,
      "friction": 0.0007,
      "inertia": 0.00012,
      "endstops": {
        "enabled": false,
        "strengthmNm": 0,
        "softZoneDeg": 5
      },
      "activePosition": {
        "enabled": false,
        "maxTorquemNm": 0,
        "maxRpm": 0,
        "yieldOnTouch": true
      }
    },
    "display": {
      "theme": "dark",
      "accent": "#FFB300",
      "brightness": 50,
      "metricUpdateHz": 10,
      "pages": [
        {
          "type": "custom",
          "title": "TIMELINE",
          "metrics": [
            "timecode",
            "clip_name",
            "playback_rate"
          ],
          "windowSeconds": 5
        }
      ],
      "burnInProtection": {
        "pixelOrbit": true,
        "orbitPixels": 1,
        "dimAfterSec": 60,
        "screenOffAfterSec": 600
      }
    },
    "inputs": {
      "rotate": "timeline_jog",
      "touch": "play_pause",
      "doubleTap": "add_marker",
      "longPress": "switch_jog_shuttle",
      "touchAndRotate": "zoom_timeline"
    },
    "actions": [
      {
        "event": "rotate",
        "transport": "vendor_usb",
        "command": "timeline_delta",
        "scale": 1,
        "deadband": 0
      },
      {
        "event": "touch",
        "transport": "hid",
        "command": "space",
        "scale": 1,
        "deadband": 0
      }
    ],
    "dataSources": {
      "presentMon": false,
      "libreHardwareMonitor": false,
      "rtssFallback": false,
      "deviceTelemetry": true,
      "preferredTransport": "usb"
    },
    "safetyUserCaps": {
      "continuousTorquemNm": 20,
      "transientTorquemNm": 40,
      "selfDriveTorquemNm": 8,
      "selfDriveRpm": 45
    }
  }
]
